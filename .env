# Default Compose profile selection for this repo.
#
# tidal-forwarder (ffmpeg-based) is the production-tested forwarder. It is
# activated by default so that `docker compose up -d` works the same as
# before profiles were introduced.
#
# To experiment with the arecord-based prototype instead, run:
#   COMPOSE_PROFILES=arecord docker compose up -d
# or edit this file to set COMPOSE_PROFILES=arecord.
#
# To run both at once (not recommended — they fight over the same loopback
# capture device): COMPOSE_PROFILES=ffmpeg,arecord
COMPOSE_PROFILES=ffmpeg
